---
import type { App } from '../apps';
import styles from '../styles/AppIcon.module.css';

interface Props {
  app: App;
}

const { app } = Astro.props;
const href = app.href ?? `/apps/${app.id}`;
const text = app.description ?? app.label;
const len = text.length;
const fontSize = len <= 40 ? '1.3rem' : 
                 len <= 70 ? '1.0rem' : 
                 len <= 100 ? '0.75rem' : '0.65rem';
---

<a href={href} class={styles.scene}>
  <div class={styles.card}>
    <div class={`${styles.face} ${styles.front}`}>
      <img src={app.iconUrl} alt={app.label} width={100} height={100} />
      {app.devOnly && <span class={styles.devBadge}>DEV</span>}
      {app.wip && <span class={styles.wipBadge}>WIP</span>}
    </div>
    <div class={`${styles.face} ${styles.back}`}>
      <p class={styles.backText} style={`font-size: ${fontSize}`}>
        {text}
      </p>
    </div>
  </div>
  <div>
    <p class={styles.label}>{app.label}</p>
  </div>
</a>
