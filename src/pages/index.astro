---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import { getApp, isDevOnly } from '../apps';

const appOrder = [
  'articles',
  'backyard-flyer',
  'track-builder',
  'crsf-tester',
  'learning-react',
  'learning-sql',
];

const results = await Promise.all(appOrder.map(getApp));
const visibleApps = results
  .filter((app) => app !== undefined)
  .filter((app) => !isDevOnly(app) || import.meta.env.DEV);
---

<Base title="mefly.dev">
  <main>
    <div class="icon-row">
      {visibleApps.map((app) => (
        <AppIcon app={app} />
      ))}
    </div>
  </main>
</Base>
