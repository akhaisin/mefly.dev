---
import type { App } from '../apps';
import { navItemsFor } from '../apps';
import UrlSync from '../components/UrlSync.astro';
import DelegateMenu from '../components/DelegateMenu.astro';
import { MeflyNav } from 'mefly-nav';
import 'mefly-nav/style.css';

interface Props {
  app: App;
}

const { app } = Astro.props;
const isDev = import.meta.env.DEV;
const iframeSrc = isDev ? (app.iframeUrlLocal ?? app.iframeUrl) : app.iframeUrl;
const menuMode = app.menuMode ?? 'host';
const navItems = await navItemsFor(app.id, Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={app.iconUrl} />
    <title>{app.label} — mefly.dev</title>
    {app.description && <meta name="description" content={app.ogDescription ?? app.description} />}
    <meta property="og:title" content={`${app.label} — mefly.dev`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    {(app.ogDescription ?? app.description) && <meta property="og:description" content={app.ogDescription ?? app.description} />}
    {(app.ogImage ?? app.iconUrl) && <meta property="og:image" content={app.ogImage ?? app.iconUrl} />}
    {app.ogImageWidth && <meta property="og:image:width" content={String(app.ogImageWidth)} />}
    {app.ogImageHeight && <meta property="og:image:height" content={String(app.ogImageHeight)} />}
    <meta name="twitter:card" content={app.ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={`${app.label} — mefly.dev`} />
    {(app.ogDescription ?? app.description) && <meta name="twitter:description" content={app.ogDescription ?? app.description} />}
    {(app.ogImage ?? app.iconUrl) && <meta name="twitter:image" content={app.ogImage ?? app.iconUrl} />}
  </head>
  <body>
    {iframeSrc
      ? <iframe id="app-iframe" src={iframeSrc} title={app.label} allowfullscreen></iframe>
      : <p class="not-implemented">Not implemented yet</p>
    }
    {iframeSrc && app.urlSync && <UrlSync />}
    {menuMode === 'host' && (
      <MeflyNav client:load items={navItems} activeId={app.id} activationMode="hover" />
    )}
    {menuMode === 'delegate' && iframeSrc && (
      <DelegateMenu activeId={app.id} items={navItems} />
    )}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
  }

  .not-implemented {
    color: #888;
    font-family: system-ui, sans-serif;
    font-size: 1rem;
    margin: auto;
  }
</style>
